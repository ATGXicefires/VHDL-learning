# 用法 (在 Pin_Finder 資料夾): vivado -mode batch -source build.tcl
# 產生 pin_finder.xdc、pin_map.txt、pin_finder.bit, 報告輸出到 out/
# 產生的檔案只用 ASCII: Vivado 的 Tcl 在 Windows 上不一定用 UTF-8 寫檔

set root [file normalize [file dirname [info script]]]
set part xc7z020clg484-1

# 以下腳位取自板子設定檔 EGO-XZ7/1.1/part0_pins.xml
set clk_pin  Y9
set rst_pin  M15
set led_pins {T22 T21 U22 U21 V22 W22 U19 U14}
# 其餘開關與按鈕一直被板上電路拉住, 留在 probe 裡只會在撥動時誤報
set skip_pins {F22 G22 H22 F21 H19 H18 H17 P16 R16 N15 R18 T18}

# 沒有電路圖, bank 電壓依板子設定檔推定 (bank 13 時脈、33 LED 是 LVCMOS33; 34/35 開關按鈕是 LVCMOS25)
# 推錯也判得出 0/1: probe 只當輸入, 訊號不是 bank 自己的上拉 (VCCO) 就是 GND
array set bank_std {13 LVCMOS33 33 LVCMOS33 34 LVCMOS25 35 LVCMOS25}

# get_package_pins 一定要有開啟的 design, 用空的 design 只查腳位
link_design -part $part
set used [concat $clk_pin $rst_pin $led_pins $skip_pins]
set probes {}
foreach b {13 33 34 35} {
    foreach p [lsort -dictionary [get_package_pins -filter "IS_GENERAL_PURPOSE == 1 && IS_BONDED == 1 && BANK == $b"]] {
        if {[lsearch -exact $used $p] < 0} {
            lappend probes [list $p $b [get_property PIN_FUNC [get_package_pins $p]]]
        }
    }
}
close_design

set n [llength $probes]
if {$n > 255} {
    error "LD7..LD0 only has 8 bits, at most 255 probes (got $n)"
}

set fx [open $root/pin_finder.xdc w]
puts $fx "## generated by build.tcl, edit build.tcl instead"
puts $fx "set_property -dict {PACKAGE_PIN $clk_pin IOSTANDARD LVCMOS33} \[get_ports CLK\]"
puts $fx "create_clock -period 10.000 -name sys_clk \[get_ports CLK\]"
puts $fx "set_property -dict {PACKAGE_PIN $rst_pin IOSTANDARD LVCMOS25} \[get_ports RST\]"
set i 0
foreach p $led_pins {
    puts $fx "set_property -dict {PACKAGE_PIN $p IOSTANDARD LVCMOS33} \[get_ports {led\[$i\]}\]"
    incr i
}
set i 0
foreach e $probes {
    lassign $e p b f
    puts $fx "set_property -dict {PACKAGE_PIN $p IOSTANDARD $bank_std($b) PULLTYPE PULLUP} \[get_ports {probe\[$i\]}\]"
    incr i
}
puts $fx "set_false_path -from \[get_ports {RST probe\[*\]}\]"
close $fx

set fm [open $root/pin_map.txt w]
puts $fm "LED value = idx in binary (LEDs on the right edge, top LED7 = MSB, lit = 1). iostd is guessed from the board file, measure to confirm."
puts $fm ""
puts $fm [format "%-11s %4s  %-5s %-5s %-9s %s" "LD7..LD0" "idx" "pin" "bank" "iostd" "pin_func"]
set i 0
foreach e $probes {
    lassign $e p b f
    set bits [format %08b [expr {$i + 1}]]
    puts $fm [format "%-11s %4d  %-5s %-5s %-9s %s" "[string range $bits 0 3] [string range $bits 4 7]" [expr {$i + 1}] $p $b $bank_std($b) $f]
    incr i
}
close $fm

# read_vhdl / read_xdc 收的是檔案清單, 路徑有空格 (University learning data) 時要包成 list 才不會被拆開
read_vhdl [list $root/pin_finder.vhd]
read_xdc [list $root/pin_finder.xdc]
synth_design -top pin_finder -part $part -generic N=$n
opt_design
place_design
route_design

file mkdir $root/out
report_timing_summary -max_paths 5 -file $root/out/timing.rpt
report_utilization -file $root/out/utilization.rpt
report_drc -file $root/out/drc.rpt
write_bitstream -force $root/pin_finder.bit
